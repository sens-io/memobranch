{
  "name": "agent-memory-wiki",
  "version": "1.0.0",
  "description": "A Git-native, LLM-wiki memory layer for AI agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "amem": "dist/cli.js",
    "amem-mcp": "dist/mcp.js"
  },
  "files": [
    "dist",
    "README.md",
    ".env.example",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "audit:prod": "npm audit --omit=dev"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agent-memory",
    "llm-wiki",
    "mcp",
    "git",
    "knowledge-base"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^6.0.0"
  }
}
