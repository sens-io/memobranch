# OpenAI-compatible Chat Completions endpoint. Only needed for `capture --extract` and `ask`.
AMEM_LLM_API_KEY=
AMEM_LLM_MODEL=gpt-4.1-mini
AMEM_LLM_BASE_URL=https://api.openai.com/v1

# Used as Git author metadata for CLI mutations.
AMEM_ACTOR_ID=agent
AMEM_ACTOR_NAME=AI Agent
AMEM_ACTOR_EMAIL=agent@agent-memory.local

# Default vault used by the MCP process.
AMEM_VAULT=/absolute/path/to/your-memory-vault
